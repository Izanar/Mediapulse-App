# ==========================================
# Project Settings
# ==========================================
PROJECT_NAME="MediaPulse API"
VERSION=0.1.0
API_V1_STR=/api/v1

# ==========================================
# Database Settings (PostgreSQL)
# ==========================================
# Используйте "postgres" при запуске в Docker Compose или "localhost" при запуске вне Docker
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mediapulse
POSTGRES_PASSWORD=mediapulse_secret
POSTGRES_DB=mediapulse

# ==========================================
# Redis Settings
# ==========================================
# Используйте "redis" при запуске в Docker Compose или "localhost" при запуске вне Docker
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# Auth & JWT Settings
# ==========================================
# Replace with a unique value of at least 43 characters before starting the app.
SECRET_KEY=replace-with-a-generated-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# S3 Settings
# ==========================================
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY=<your-r2-access-key>
S3_SECRET_KEY=<your-r2-secret-key>
S3_BUCKET_NAME=media-originals
AWS_REGION=us-east-1