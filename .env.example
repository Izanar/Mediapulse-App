# ==========================================
# Project Settings
# ==========================================
PROJECT_NAME="MediaPulse API"
VERSION=0.1.0
API_V1_STR=/api/v1

# ==========================================
# Database Settings (PostgreSQL)
# ==========================================
# Используйте "postgres" при запуске в Docker Compose или "localhost" при запуске вне Docker
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mediapulse
POSTGRES_PASSWORD=mediapulse_secret
POSTGRES_DB=mediapulse

# ==========================================
# Redis Settings
# ==========================================
# Используйте "redis" при запуске в Docker Compose или "localhost" при запуске вне Docker
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# Auth & JWT Settings
# ==========================================
SECRET_KEY=change-this-super-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# MinIO / S3 Settings
# ==========================================
# Используйте "http://minio:9000" в Docker или "http://localhost:9000" локально
S3_ENDPOINT_URL=https://158b52dcae768c7b229bb581dfec81b5.r2.cloudflarestorage.com
S3_ACCESS_KEY=95d0a66db0e9e18c678d8b3a85fdaf22
S3_SECRET_KEY=5aa9cf9e7f2104d3be3b1d14e779cb41fc4c4d700e873e5b1cab3ee1b794b5c8
S3_BUCKET_NAME=media-originals
AWS_REGION=us-east-1

# Переменные авторизации сервера MinIO (для docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin