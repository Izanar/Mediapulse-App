# ==========================================
# Project Settings
# ==========================================
PROJECT_NAME="MediaPulse API"
VERSION=0.1.0
API_V1_STR=/api/v1

# ==========================================
# Database Settings (PostgreSQL)
# ==========================================
# Используйте "postgres" при запуске в Docker Compose или "localhost" при запуске вне Docker
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=mediapulse
# Development placeholder only. Use a unique strong value outside local development.
POSTGRES_PASSWORD=mediapulse_secret
POSTGRES_DB=mediapulse

# ==========================================
# Redis Settings
# ==========================================
# Используйте "redis" при запуске в Docker Compose или "localhost" при запуске вне Docker
REDIS_HOST=redis
REDIS_PORT=6379

# ==========================================
# Auth & JWT Settings
# ==========================================
# Development placeholder only. Set a unique random value outside local development.
SECRET_KEY=0253183ee086ddde9c1505b7290e8cdb7a9385b04423a8a4aaf8c1f6fea24d0b
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ==========================================
# S3 Settings
# ==========================================

S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
S3_ACCESS_KEY=replace-with-r2-access-key
S3_SECRET_KEY=replace-with-r2-secret-key
S3_BUCKET_NAME=media-originals
AWS_REGION=us-east-1

# Connector token для локального Cloudflare Tunnel; используется Mediapulse-Infra,
# а не API приложения. Bootstrap сохраняет его в Vault, ESO передаёт его cloudflared.
# Заполните в .env локально; не коммитьте.
CLOUDFLARE_TUNNEL_TOKEN=сюда_только_connector_token

